{
  "name": "1car-edms",
  "version": "1.0.0",
  "description": "Electronic Document Management System for 1CAR",
  "main": "src/backend/server.js",
  "private": true,
  "workspaces": [
    "src/backend",
    "src/frontend"
  ],
  "scripts": {
    "start": "node src/backend/server.js",
    "dev": "concurrently \"npm:backend:dev\" \"npm:frontend:dev\"",
    "backend:dev": "nodemon src/backend/server.js",
    "frontend:dev": "cd src/frontend && npm start",
    "build": "cd src/frontend && npm run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd src/backend && jest --coverage",
    "test:frontend": "cd src/frontend && npm test",
    "setup": "node scripts/setup.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dangnguyen-1car/edms.git"
  },
  "keywords": [
    "document-management",
    "edms",
    "1car",
    "nodejs",
    "react",
    "sqlite"
  ],
  "author": "1CAR Development Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dangnguyen-1car/edms/issues"
  },
  "homepage": "https://github.com/dangnguyen-1car/edms#readme",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@tailwindcss/forms": "^0.5.3",
    "@types/js-cookie": "^3.0.2",
    "@types/node-cache": "^4.2.5",
    "autoprefixer": "^10.4.13",
    "concurrently": "^7.6.0",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.2.0",
    "jest": "^29.3.1",
    "nodemon": "^2.0.20",
    "postcss": "^8.4.21",
    "prettier": "^3.0.0",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.2.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^4.39.2",
    "@tanstack/react-query-devtools": "^4.39.2",
    "axios": "^1.3.0",
    "bcrypt": "^5.1.0",
    "clsx": "^1.2.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.0.1",
    "fs-extra": "^11.1.0",
    "helmet": "^6.0.1",
    "http-proxy-middleware": "^2.0.6",
    "joi": "^17.7.1",
    "js-cookie": "^3.0.1",
    "jsonwebtoken": "^9.0.0",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.1.1",
    "react": "^18.2.0",
    "react-datepicker": "^8.4.0",
    "react-diff-viewer-continued": "^3.2.6",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "^2.4.0",
    "react-icons": "^4.7.1",
    "react-pdf": "^7.1.0",
    "react-router-dom": "^6.8.0",
    "react-scripts": "5.0.1",
    "react-select": "^5.10.1",
    "recharts": "^3.0.0",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0",
    "winston": "^3.8.2",
    "xlsx": "^0.18.5",
    "yargs": "^18.0.0"
  }
}